# Copy to .env and fill in. Without GROQ_API_KEY the app still runs in OFFLINE mode
# (rule-based generation) so you can demo the pipeline, but quality is much better with Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# "auto" = sentence-transformers if installed, else hashing fallback. Or force: st | hash
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Backend
DATA_DIR=./data
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=*

# Frontend -> backend URL
API_URL=http://localhost:8000
